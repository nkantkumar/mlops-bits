# Production container for individual model microservices
FROM python:3.14-slim AS base

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /uvx /bin/

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src/ ./src/
COPY serving/ ./serving/
COPY params.yaml ./
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app:/app/src"
ENV PYTHONUNBUFFERED=1

ARG MODEL_PORT=8001
ENV MODEL_PORT=${MODEL_PORT}

EXPOSE ${MODEL_PORT}

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request, os; urllib.request.urlopen('http://localhost:' + os.getenv('MODEL_PORT', '8001') + '/health')" || exit 1

CMD ["sh", "-c", "uvicorn mlops_bits.api:app --host 0.0.0.0 --port ${MODEL_PORT}"]


